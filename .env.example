# 이 파일을 복사해서 .env 를 만들고 실제 값을 채운다. (.env 는 Git에 올라가지 않는다)

# Supabase > Project Settings > Data API (또는 대시보드 상단 Connect)
SUPABASE_URL=https://xxxxxxxx.supabase.co

# Supabase > Project Settings > API Keys > Secret key (sb_secret_...)
# 예전 방식 키를 쓰는 경우 Legacy API keys 탭의 service_role 키
# ⚠️ 서버에서만 사용. 브라우저 코드나 GitHub에 절대 올리지 말 것.
SUPABASE_SECRET_KEY=

# Google AI Studio (https://aistudio.google.com) > Get API key
GEMINI_API_KEY=
