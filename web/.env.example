# 이 파일을 복사해서 .env.local 을 만들고 실제 값을 채운다. (.env.local 은 Git에 올라가지 않는다)
# Vercel에 배포할 때는 Project Settings > Environment Variables 에 같은 이름으로 넣는다.

# Supabase > Project Settings > Data API
SUPABASE_URL=https://xxxxxxxx.supabase.co

# Supabase > Project Settings > API Keys > Secret key (sb_secret_...)
# ⚠️ 서버에서만 쓰인다. NEXT_PUBLIC_ 을 붙이지 말 것.
SUPABASE_SECRET_KEY=

# Google AI Studio > Get API key
GEMINI_API_KEY=

# 브라우저(익명 ID)당 24시간 질문 수 제한 (선택, 기본 30)
DAILY_MESSAGE_LIMIT=30
